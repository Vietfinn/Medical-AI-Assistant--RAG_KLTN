# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq (Llama 3)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Cohere (Reranker)
COHERE_API_KEY=your_cohere_api_key_here

# Qdrant
# Use "cloud" for Qdrant Cloud or "local" for local Docker
QDRANT_MODE=cloud
QDRANT_CLOUD_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Local Qdrant (used when QDRANT_MODE=local)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Collection
QDRANT_COLLECTION=vnhealthqa

# MongoDB Atlas (or local)
MONGODB_URL=mongodb+srv://admin:<db_password>@cluster0.wdlhgqp.mongodb.net/medical_ai?retryWrites=true&w=majority&appName=Cluster0

# Clerk Authentication (SSO)
CLERK_JWKS_URL=https://<your-clerk-domain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<your-clerk-domain>.clerk.accounts.dev

# Gmail SMTP (Welcome Email)
GMAIL_SENDER=aimcare.chat@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password


# CORS — Frontend URL (Vercel)
# Khi deploy, đặt URL Vercel tại đây để Backend cho phép gọi cross-origin
FRONTEND_URL=https://your-app.vercel.app
